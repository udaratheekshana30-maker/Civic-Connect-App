# Copy this file to `.env` and fill in the values. Never commit `.env`.
# EXPO_PUBLIC_* values are bundled into the app (they are not secrets on the
# device). Security comes from firestore.rules, not from hiding these keys.

# Firebase console → Project settings → Your apps → Web app → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=civic-connect-29dab.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=civic-connect-29dab
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=civic-connect-29dab.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=944076240729
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (free) → Settings → Upload → Upload presets → Add → Signing mode: Unsigned
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Optional: shown as "Contact support" in Help & FAQ (button hidden if empty).
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional: contact email sent to Nominatim (OpenStreetMap geocoding) as its
# usage policy recommends. Use a project/team address, not a personal one.
EXPO_PUBLIC_NOMINATIM_EMAIL=
